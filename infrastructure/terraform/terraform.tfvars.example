aws_region       = "eu-central-1"
environment      = "production"
app_name         = "livecenter"

# Existing Amplify app (already deployed)
amplify_app_id   = "dl5iyvnws81xx"
amplify_domain   = "dl5iyvnws81xx.amplifyapp.com"

# Optional: Custom domain (leave empty to use Amplify default)
domain_name = ""

# Google OAuth (get from https://console.cloud.google.com/)
# See GOOGLE_OAUTH_SETUP.md for instructions
google_client_id     = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
google_client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

# Note: After first terraform apply, update Google OAuth redirect URIs
# with the actual Cognito domain from: terraform output cognito_domain
